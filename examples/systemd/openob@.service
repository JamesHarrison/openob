[Unit]
Description=OpenOB %i broadcast audio link
Documentation=https://github.com/JamesHarrison/openob

# v6 has no Redis dependency. We just need the network and (if applicable)
# the sound subsystem before the link comes up.
After=network-online.target sound.target
Wants=network-online.target

# Bail out if the service crashes too quickly too often. systemd 230+ moved
# these keys from [Service] into [Unit].
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple

# Each instance reads its CLI args from an env file, so a single template
# unit handles many links. Create /etc/openob/<instance>.conf with a single
# OPENOB_ARGS=... line — see openob-tx.conf.example / openob-rx.conf.example.
EnvironmentFile=/etc/openob/%i.conf

# Per-link TOML config lives under /etc/openob/links/<link>.toml. Override
# OPENOB_CONFIG_DIR in the per-instance .conf if you want a different layout.
Environment=OPENOB_CONFIG_DIR=/etc/openob

# The path here assumes a system-wide install (`pip install OpenOB`). For a
# venv install (`pip install -e .` inside e.g. /opt/openob), swap to
# /opt/openob/bin/openob and adjust User= if the venv lives in a home dir.
ExecStart=/usr/local/bin/openob $OPENOB_ARGS

# Restart on crash. openob's internal supervisor recovers from pipeline
# failures on its own, so a non-zero exit means something genuinely
# unrecoverable (config error, missing GStreamer plugin, persistently
# unreachable network). A clean SIGTERM exits 0 — systemctl stop will NOT
# trigger a restart.
Restart=on-failure
RestartSec=2s

# Run unprivileged. The 'openob' user must be in the 'audio' group to reach
# ALSA / JACK devices on most distros — see README.md for the create-user
# snippet. JACK 2 users may also need access to /dev/shm; if your link uses
# JACK, add `SupplementaryGroups=audio jackuser` (or whatever your distro
# names that group) here.
User=openob
Group=openob
SupplementaryGroups=audio

# Hardening that doesn't conflict with audio I/O. ProtectSystem=strict
# makes /usr and /etc read-only for the service. ReadWritePaths is empty
# because openob doesn't write anywhere by default — add e.g. /var/log/openob
# if you redirect logs to a file via standard shell tooling.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=false
LockPersonality=true

# Resource caps — bounds the blast radius if a parser bug or attacker-driven
# memory growth tries to take the box with the audio. Sized comfortably
# above any realistic OpenOB workload (single Opus link uses ~50 MB, multipath
# adds another ~30 MB) and well below the smallest target Pi (1 GB on Pi 3B+).
# Lower these on memory-tight boxes; raise if you're stacking many links.
MemoryHigh=256M
MemoryMax=512M
TasksMax=128
LimitNOFILE=1024

# IP allowlisting is OFF by default because OpenOB's deployment shapes
# (dynamic 4G IPs, multipath with N source IPs, N:1 hub-spoke) don't
# tolerate static peer pinning — see examples/config/remote-multipath-4g/
# for why. If you have a fixed-peer STL with a known TX subnet, uncomment
# and edit:
# IPAddressDeny=any
# IPAddressAllow=localhost 10.0.0.0/8 224.0.0.0/4

[Install]
WantedBy=multi-user.target
