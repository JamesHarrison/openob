# OpenOB v6 systemd instance config — TX (transmitter) end.
#
# Workflow:
#   1. Lay down a per-link TOML at /etc/openob/links/<link>.toml
#      (see openob-link.toml.example in this directory).
#   2. Copy this file to /etc/openob/<instance>.conf, set OPENOB_ARGS below.
#   3. sudo systemctl enable --now openob@<instance>
#
# <instance> is purely a systemd-side label; the actual link name on the
# wire comes from OPENOB_ARGS ("studio-stl" here) and must match the file
# /etc/openob/links/studio-stl.toml.
#
# All audio/codec/security/PSK config lives in the TOML — keep this file
# minimal so it's the same for both ends.

OPENOB_ARGS="tx studio-stl"

# Reference (run `openob -h` for the full list):
#   openob tx <link_name> [--config FILE] [--node-name NAME] [opts]
#
# Common flag overrides (anything in the TOML can also be CLI-overridden):
#   --receiver-host HOST       destination (overrides receiver_host in TOML)
#   --bitrate KBPS             override codec bitrate
#   --audio-input alsa|jack|test
#   --alsa-device hw:0
#   --security none|psk        override security mode
#
# PSK is *never* accepted on the CLI — set it in the link TOML or via the
# OPENOB_PSK_<NAME> env var with `psk = "${OPENOB_PSK_NAME}"` substitution.
