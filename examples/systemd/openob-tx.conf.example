# OpenOB instance config — TX (transmitter) end.
#
# Copy to /etc/openob/<instance-name>.conf and adapt the values below.
# Then enable the link with:
#     sudo systemctl enable --now openob@<instance-name>
#
# <instance-name> is purely a systemd-side label; the actual link name on
# the wire is the third positional argument below ("studio-stl" here).
#
# Format: a single OPENOB_ARGS= line containing the full openob CLI arguments
# in the same order you'd type them on a shell. Mind the quoting if any
# value contains spaces.

OPENOB_ARGS="redis.example.com studio-tx studio-stl tx 192.0.2.50 -a alsa -d hw:0 -e opus -b 192 -j 40"

# Reference (run `openob -h` for the full list):
#   1st positional   redis host (or host:port; bracket form for IPv6)
#   2nd positional   node name (free-form, identifies *this* end)
#   3rd positional   link name (must match the RX end)
#   4th positional   mode: tx
#   5th positional   receiver host (where audio packets are sent)
#   -a / --audio_input    auto | alsa | jack | test
#   -d / --alsa_device    e.g. hw:0
#   -e / --encoding       opus | pcm
#   -b / --bitrate        kbps; opus only
#   -j / --jitter_buffer  ms
#   -c / --channels       force input channel count (mono ALSA → stereo etc)
#   --qext                Opus quality extensions (>=1024 kbps recommended)
