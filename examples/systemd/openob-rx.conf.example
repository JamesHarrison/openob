# OpenOB v6 systemd instance config — RX (receiver) end.
#
# Workflow:
#   1. Lay down a per-link TOML at /etc/openob/links/<link>.toml
#      (see openob-link.toml.example in this directory).
#   2. Copy this file to /etc/openob/<instance>.conf, set OPENOB_ARGS below.
#   3. sudo systemctl enable --now openob@<instance>
#
# Both ends of the same link can share the systemd instance name — they
# live on different boxes — but the link_name in OPENOB_ARGS must match
# both ends and the TOML file basename.

OPENOB_ARGS="rx studio-stl"

# Reference (run `openob -h` for the full list):
#   openob rx <link_name> [--config FILE] [--node-name NAME] [opts]
#
# Common flag overrides:
#   --audio-output alsa|jack|test|wav
#   --alsa-device hw:0
#   --wav-file PATH            capture decoded audio to a WAV (test/debug)
#   --caps-from-config         skip the in-band caps wait, derive from TOML
#                              (deterministic startup for STL deployments)
